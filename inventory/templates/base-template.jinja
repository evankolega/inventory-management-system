<!doctype html>
<html>
    <head>
        <meta charset="utf-8"/>
        <title>{{ title }} - Inventory Management</title>
        <link rel="stylesheet" href="{{ url_for('static', filename='bootstrap.min.css') }}">
        <link rel="icon" href="{{ url_for('static', filename='site_icon.png') }}" class="js-favicon">
        <!--div>Icons made by <a href="http://www.freepik.com" title="Freepik">Freepik</a> from <a href="https://www.flaticon.com/" title="Flaticon">www.flaticon.com</a> is licensed by <a href="http://creativecommons.org/licenses/by/3.0/" title="Creative Commons BY 3.0" target="_blank">CC 3.0 BY</a></div-->
        <script src="{{ url_for('static', filename='jquery-3.3.1.slim.min.js') }}"></script>
        <script src="{{ url_for('static', filename='bootstrap.min.js') }}"></script>
        <style lang="css">
            .slide-container { width: 100%; }
            .slider {
                -webkit-appearance: none;
                width: 100%;
                height: 10px;
                border-radius: 5px;
                background: #d3d3d3;
                outline: none;
                opacity: 0.7;
                -webkit-transition: .2s;
                transition: opacity .2s;
            }
            .slider:hover { opacity: 1; }
            .slider::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 23px;
                height: 24px;
                border: 0;
                background: url({{ url_for('static', filename='range_icon.png') }});
                cursor: pointer;
            }
            .slider::-moz-range-thumb {
                width: 23px;
                height: 24px;
                border: 0;
                background: url({{ url_for('static', filename='range_icon.png') }});
                cursor: pointer;
            }
            .container { padding-top: 70px; }
        </style>
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark" style="position: fixed;width: 100%;z-index: 2;">
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mr-auto bg-dark alert-light">{{ title }}</ul>
                
                <!-- Navigation Links (only show if authenticated) -->
                {% if current_user %}
                    {% for k, v in link|items %}
                    <div class="col-auto">
                      <button class="btn btn-primary" onclick="location.href='{{ v }}'" {{ 'disabled' if k == title }}>{{ k }}</button>
                    </div>
                    {% endfor %}
                {% endif %}
                
                <!-- User Authentication -->
                <div class="navbar-nav ms-auto">
                    {% if current_user %}
                        <span class="navbar-text me-3">
                            <i class="fas fa-user"></i> {{ current_user.username }}
                        </span>
                        <a href="{{ url_for('logout') }}" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    {% else %}
                        <a href="{{ url_for('login') }}" class="btn btn-outline-light btn-sm me-2">Login</a>
                        <a href="{{ url_for('register') }}" class="btn btn-light btn-sm">Register</a>
                    {% endif %}
                </div>
            </div>
	    </nav>
        
        <!-- Flash Messages -->
        <div class="container" style="padding-top: 20px;">
            {% with messages = get_flashed_messages(with_categories=true) %}
                {% if messages %}
                    {% for category, message in messages %}
                        <div class="alert alert-{% if category == 'error' %}danger{% elif category == 'warning' %}warning{% elif category == 'success' %}success{% else %}info{% endif %} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    {% endfor %}
                {% endif %}
            {% endwith %}
        </div>
        
        {% block content %}
        {% endblock %}
    </body>
</html>